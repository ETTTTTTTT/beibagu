{
  "name": "beibagu",
  "displayName": "beibagu · 面试背题",
  "description": "IDEA/VS Code 摸鱼刷题插件：DeepSeek AI 一键详解/打分（白嫖网页 Token），艾宾浩斯复习，题库导入导出。",
  "version": "0.1.59",
  "publisher": "huaxin",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ETTTTTTTT/beibagu.git"
  },
  "bugs": {
    "url": "https://github.com/ETTTTTTTT/beibagu/issues"
  },
  "homepage": "https://github.com/ETTTTTTTT/beibagu#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "interview",
    "java",
    "quiz",
    "八股文",
    "背题",
    "beibagu",
    "DeepSeek",
    "摸鱼"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shirohaQuiz.open",
        "title": "打开背题面板",
        "category": "beibagu",
        "icon": "$(book)"
      },
      {
        "command": "shirohaQuiz.importBank",
        "title": "导入题库 JSON",
        "category": "beibagu"
      },
      {
        "command": "shirohaQuiz.resetProgress",
        "title": "重置学习进度",
        "category": "beibagu"
      }
    ],
    "keybindings": [
      {
        "command": "shirohaQuiz.open",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      },
      {
        "command": "shirohaQuiz.open",
        "key": "f9"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shirohaQuiz",
          "title": "面试背题",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "shirohaQuiz": [
        {
          "id": "shirohaQuiz.launcher",
          "name": "面试背题"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "shirohaQuiz.open",
          "when": "view == shirohaQuiz.launcher",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "shirohaQuiz.open",
          "group": "navigation",
          "icon": "$(book)"
        }
      ]
    },
    "configuration": {
      "title": "beibagu",
      "properties": {
        "shirohaQuiz.chromePath": {
          "type": "string",
          "default": "",
          "description": "Google Chrome 可执行文件路径。留空则自动检测，用于「DeepSeek 详解」等外链打开。"
        },
        "shirohaQuiz.openLinksInChrome": {
          "type": "boolean",
          "default": true,
          "description": "外链（如 DeepSeek 详解）优先用 Chrome 打开"
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package",
    "publish:vscode": "npx --yes @vscode/vsce publish"
  }
}
